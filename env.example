# Rename this file to .env.example (kept as env.example because tooling here cannot write .env* files).
# To use it: copy to .env.local and fill in real values. Never commit .env.local.

# --- Enquiry emails (app/api/enquiry) ---
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered. Separate several addresses with commas.
ENQUIRY_TO_EMAIL=contact@layzox.com
# Sender. Use an address on a domain you have verified in Resend, for example:
# Layzox Website <enquiries@yourdomain.com>
ENQUIRY_FROM_EMAIL=
# Optional: override the Resend endpoint (used by tests with a local mock).
# RESEND_API_URL=

# --- Client ---
# Optional: send forms to a different endpoint than /api/enquiry.
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# If the API is not configured or fails, forms fall back to a pre-filled WhatsApp message.
