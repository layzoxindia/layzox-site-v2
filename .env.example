# Public site URL (used for canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.layzox.com

# Enquiry email delivery (https://resend.com). Without these, forms fall back to WhatsApp.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=you@yourcompany.com
# Must be a sender verified in Resend. The default works only for testing.
ENQUIRY_FROM_EMAIL=Layzox Website <onboarding@resend.dev>
